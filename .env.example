# Visitors enter their own keys in the app. The keys below are used only when
# ALLOW_SERVER_KEYS=1 (local convenience). Never enable that on a public deployment.
# ALLOW_SERVER_KEYS=1
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=

# Optional
# ELEVENLABS_MODEL=eleven_v3
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
# Disfluency count = word_count × this value
# DISFLUENCY_RATE_PER_WORD=0.09
