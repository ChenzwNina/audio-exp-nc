OPENAI_API_KEY=sk-...
# Optional defaults
# CONVERSATION_MAX_TURNS=12
#
# ElevenLabs TTS (with-timestamps API — one clip per segment + backchannel)
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_v3
# ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
#
# Disfluency rate: Poisson mean = word_count × this value (default 0.14 ≈ 14% per word)
# DISFLUENCY_RATE_PER_WORD=0.14
#
#   PERSONA_AUTHORING_MODEL — initial_view + personal_story (Generate personas)
#   _reply_for_speaker — live conversation turns
